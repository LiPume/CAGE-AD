diff --git a/carla_bridge/actor/ego_vehicle.py b/carla_bridge/actor/ego_vehicle.py
--- a/carla_bridge/actor/ego_vehicle.py
+++ b/carla_bridge/actor/ego_vehicle.py
@@ -297,6 +297,7 @@ class EgoVehicle(Vehicle):
