             throttle_gain = float(conversion.get("throttle_gain", 1.0))
             brake_gain = float(conversion.get("brake_gain", 1.0))
+            steering_gain = conversion.get("steering_gain")
             vehicle_control.throttle = min(
                 1.0, max(0.0, cyber_vehicle_control.throttle * throttle_gain / 100.0)
             )
@@ -305,7 +306,9 @@ class EgoVehicle(Vehicle):
             vehicle_control.brake = min(
                 1.0, max(0.0, cyber_vehicle_control.brake * brake_gain / 100.0)
             )
-            if cyber_vehicle_control.steering_target < 0:
+            if steering_gain is not None:
+                steering_target = cyber_vehicle_control.steering_target * float(steering_gain)
+            elif cyber_vehicle_control.steering_target < 0:
                 steering_target = (
                         cyber_vehicle_control.steering_target * self.right_turn_ratio
                 )
