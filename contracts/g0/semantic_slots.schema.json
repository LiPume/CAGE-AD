{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cage-ad.local/contracts/semantic_slots.schema.json",
  "title": "CAGE-AD semantic slot window v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "stack", "semantic_slot", "required_regime", "window", "provenance", "native_topics_disclosed", "oracle_fields_present", "control_target", "vehicle_response"],
  "properties": {
    "schema_version": {"const": "semantic_window_v0"},
    "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "stack": {"type": "string", "minLength": 1},
    "semantic_slot": {"const": "tracking_execution"},
    "required_regime": {"const": "L1"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds"],
      "properties": {
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "provenance": {"type": "string", "minLength": 1},
    "native_topics_disclosed": {"const": false},
    "oracle_fields_present": {"const": false},
    "control_target": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/controlTarget"}
    },
    "vehicle_response": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/vehicleResponse"}
    }
  },
  "$defs": {
    "controlTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "throttle_pct", "brake_pct", "steering_pct"],
      "properties": {
        "t": {"type": "number", "minimum": 0},
        "throttle_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "brake_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "steering_pct": {"type": "number", "minimum": -100, "maximum": 100}
      }
    },
    "vehicleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "speed_mps", "throttle_pct", "brake_pct", "steering_pct"],
      "properties": {
        "t": {"type": "number", "minimum": 0},
        "speed_mps": {"type": "number", "minimum": 0},
        "throttle_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "brake_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "steering_pct": {"type": "number", "minimum": -100, "maximum": 100}
      }
    }
  }
}
