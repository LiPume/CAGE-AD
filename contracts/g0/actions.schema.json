{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cage-ad.local/contracts/actions.schema.json",
  "title": "CAGE-AD diagnostic action v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_id", "proposed_by", "target_hypotheses", "required_regime", "action_type", "intervention_class", "semantic_slot", "replacement", "evidence_ids", "diagnosis", "measured_query_cost", "evidence"],
  "properties": {
    "schema_version": {"const": "diagnostic_action_v0"},
    "action_id": {"type": "string", "minLength": 1},
    "proposed_by": {"type": "string", "minLength": 1},
    "target_hypotheses": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "required_regime": {"const": "L1"},
    "action_type": {"const": "intervention"},
    "intervention_class": {"const": "I2_semantic_replacement"},
    "semantic_slot": {"const": "control_target"},
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["throttle_pct", "brake_pct", "steering_pct", "duration_seconds", "source", "uses_ground_truth"],
      "properties": {
        "throttle_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "brake_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "steering_pct": {"type": "number", "minimum": -100, "maximum": 100},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "source": {"type": "string", "minLength": 1},
        "uses_ground_truth": {"const": false}
      }
    },
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_set", "confidence", "observed_lag_seconds"],
      "properties": {
        "prediction_set": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "observed_lag_seconds": {"type": ["number", "null"]}
      }
    },
    "measured_query_cost": {"type": "object"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
